module cdc_sync #(
    param WIDTH : p32 = 1,
    param STAGES: p32 = 2,
) (
    dest_clk_i : input  'd clock       ,
    dest_rst_i : input  'd reset       ,
    src_data_i : input  's logic<WIDTH>,
    dest_data_o: output 'd logic<WIDTH>,
) {
    #[sv("ASYNC_REG = \"TRUE\"")]
    var sync_ffs: logic<WIDTH> [STAGES];

    unsafe (cdc) {
        always_ff {
            if_reset {
                for i in 0..STAGES {
                    sync_ffs[i] = '0;
                }
            } else {
                sync_ffs[0] = src_data_i;
                for i in 1..STAGES {
                    sync_ffs[i] = sync_ffs[i - 1];
                }
            }
        }
    }

    assign dest_data_o = sync_ffs[STAGES - 1];
}
